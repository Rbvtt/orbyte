# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# El archivo .env no se sube a git. En producción estos valores se configuran
# en los paneles de Render (backend) y Vercel (frontend), nunca en el código.

# --- Backend (FastAPI) ---

# Con "produccion" no se acepta localhost por CORS ni se crea el administrador con la
# contraseña de desarrollo. Render lo define en render.yaml.
ENTORNO=desarrollo

# Cadena de conexión de PostgreSQL.
# Formato: postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL=

# URL opcional de PostgreSQL para los tests de integración.
# Si no se define, esos tests se omiten; no uses SQLite.
TEST_DATABASE_URL=

# Clave para firmar los JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez del token de acceso.
JWT_EXPIRES_MIN=60

# Credenciales por defecto del administrador inicial (solo en desarrollo).
# El proyecto crea la cuenta `marcela@gmail.com` con este valor si no existe.
# En producción, define valores propios y no los compartas en el repositorio.
DEFAULT_ADMIN_EMAIL=marcela@gmail.com
DEFAULT_ADMIN_PASSWORD=Admin123*

# Orígenes permitidos por CORS, separados por coma.
# En local es el servidor de Vite; en Render, el dominio de Vercel.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (React) ---

# URL base de la API que consume el SPA. Vite solo expone variables con prefijo VITE_.
VITE_API_URL=http://localhost:8000
